{
  "name": "strict-next-ranger",
  "version": "0.1.0",
  "private": true,
  "description": "Strict Next.js frontend operating system: module-first architecture, TSX-only component files, package boundary enforcement, custom ESLint architecture plugin, TDD gates, security/performance/a11y/i18n baselines.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.7.0",
  "overrides": {
    "postcss": "^8.5.16"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --concurrency=4 --max-warnings=0",
    "lint:fix": "eslint . --concurrency=4 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsgo --pretty --noEmit -p tsconfig.app.json && tsgo --pretty --noEmit -p tsconfig.test.json && tsgo --pretty --noEmit -p tsconfig.node.json",
    "typecheck:tsc": "tsc --pretty --noEmit -p tsconfig.app.json && tsc --pretty --noEmit -p tsconfig.test.json && tsc --pretty --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "npx playwright install chromium",
    "test:e2e:baseline": "npx playwright test src/tests/visual --update-snapshots=missing",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test src/tests/accessibility",
    "test:visual": "playwright test src/tests/visual",
    "security:audit": "npm audit --audit-level=low",
    "security:scan": "trivy fs --scanners vuln,secret,misconfig --include-dev-deps --skip-dirs node_modules,.next,coverage,test-results,playwright-report --exit-code 1 --severity LOW,MEDIUM,HIGH,CRITICAL .",
    "quality:dead-code": "knip",
    "quality:circular": "madge src --circular --extensions ts,tsx",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "validate": "npm run quality && npm run test:e2e && npm run security:audit && npm run security:scan && npm run quality:dead-code && npm run quality:circular",
    "deps:check": "npm-check-updates",
    "deps:upgrade": "npm-check-updates -u && npm install",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-virtuoso": "^4.18.10",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260705.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.21",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "msw": "^2.14.6",
    "npm-check-updates": "^22.2.9",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
