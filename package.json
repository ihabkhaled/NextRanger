{
  "name": "strict-next-ranger",
  "version": "0.1.0",
  "private": true,
  "description": "Strict Next.js frontend operating system: module-first architecture, TSX-only component files, package boundary enforcement, custom ESLint architecture plugin, TDD gates, security/performance/a11y/i18n baselines.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.0.1 <13"
  },
  "packageManager": "npm@12.0.1",
  "overrides": {
    "@swc/helpers": "0.5.23",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "^8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "corepack npm run typecheck:app && next build --turbopack",
    "start": "next start",
    "lint": "eslint . --concurrency=off --max-warnings=0 && corepack npm run lint:severity",
    "lint:fix": "eslint . --concurrency=off --fix --max-warnings=0 && corepack npm run lint:severity",
    "lint:severity": "node support/verify-eslint-severity.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:social:generate": "node support/social-fonts.mjs --write",
    "fonts:social:check": "node support/social-fonts.mjs",
    "assets:social:generate": "corepack npm run fonts:social:generate && node support/social-images.mjs --write",
    "assets:social:check": "corepack npm run fonts:social:check && node support/social-images.mjs",
    "commitlint": "commitlint",
    "compiler:versions": "node node_modules/@typescript/native/bin/tsc --version && node node_modules/typescript/bin/tsc6 --version",
    "typecheck": "corepack npm run compiler:versions && corepack npm run typecheck:app && corepack npm run typecheck:test && corepack npm run typecheck:node && corepack npm run typecheck:compat",
    "typecheck:app": "node node_modules/@typescript/native/bin/tsc --pretty --noEmit -p tsconfig.app.json",
    "typecheck:test": "node node_modules/@typescript/native/bin/tsc --pretty --noEmit -p tsconfig.test.json",
    "typecheck:node": "node node_modules/@typescript/native/bin/tsc --pretty --noEmit -p tsconfig.node.json",
    "typecheck:compat": "node node_modules/typescript/bin/tsc6 --pretty --noEmit -p tsconfig.app.json && node node_modules/typescript/bin/tsc6 --pretty --noEmit -p tsconfig.test.json && node node_modules/typescript/bin/tsc6 --pretty --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:baseline": "playwright test src/tests/visual --update-snapshots=all",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test src/tests/accessibility",
    "test:visual": "playwright test src/tests/visual",
    "security:audit": "corepack npm audit --omit=dev --audit-level=low",
    "security:scan": "trivy fs --scanners vuln,secret,misconfig --include-dev-deps --skip-dirs node_modules,.next,coverage,test-results,playwright-report --exit-code 1 --severity LOW,MEDIUM,HIGH,CRITICAL .",
    "quality:dead-code": "knip",
    "quality:circular": "depcruise --config .dependency-cruiser.cjs src",
    "quality": "corepack npm run assets:social:check && corepack npm run lint && corepack npm run typecheck && corepack npm run test:coverage && corepack npm run build && corepack npm run quality:dead-code && corepack npm run quality:circular",
    "gate:push": "corepack npm run format:check && corepack npm run quality && corepack npm run security:audit",
    "validate": "corepack npm run gate:push && corepack npm run test:e2e && corepack npm run security:scan",
    "deps:check": "npm-check-updates --errorLevel 2",
    "deps:check:all": "npm-check-updates --reject \"/(?!)\"",
    "deps:upgrade": "npm-check-updates -u && corepack npm install",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "postinstall": "node support/patch-brace-expansion-compat.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.29.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-virtuoso": "^4.18.11",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "npm-check-updates": "^23.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.43": true,
    "unrs-resolver@1.12.2": true,
    "msw": false
  }
}
